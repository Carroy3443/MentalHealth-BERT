<?xml version="1.0" encoding="UTF-8"?>
<!--
*************************************************************************
                       AnyLogic Project File
              Stephen Center Shelter Front Office Simulation
*************************************************************************

  IMPORTANT - HOW TO USE THIS FILE
  --------------------------------
  AnyLogic .alp files store internal IDs, geometry, presentation layers,
  connector routing, and per-block visual state that must be generated by
  AnyLogic itself.  This file therefore acts as a *structural reference*:

    - it is a syntactically valid AnyLogic workspace XML
    - it documents every block, parameter, and connection used by the
      three scenarios (Base, Improvement 1, Improvement 2)
    - it lists exact distributions, probabilities, and capacities

  To produce a fully runnable AnyLogic model, open AnyLogic 8.x and
  follow the step-by-step instructions in AnyLogic_Build_Guide.md.  The
  guide reproduces every block listed below (names, types, parameters)
  in the order they should be added to the canvas.

  VERSION TARGETED: AnyLogic 8.7+ (Personal Learning Edition is sufficient)
  TIME UNIT:       MINUTES
  STOP CONDITION:  120 minutes (one 6:00-8:00 PM observation window)
  REPLICATIONS:    30 (different random seeds, parametric experiment)
-->
<AnyLogicWorkspace WorkspaceVersion="1.9" AnyLogicVersion="8.8.0" AlpVersion="8.8.0">
<Model>
  <Id>1730000000001</Id>
  <Name><![CDATA[ShelterSimulation]]></Name>
  <EngineVersion>6</EngineVersion>
  <JavaPackageName><![CDATA[sheltersimulation]]></JavaPackageName>
  <ModelTimeUnit><![CDATA[Minute]]></ModelTimeUnit>

  <!-- =================================================================
       AGENT TYPES
       ================================================================= -->
  <ActiveObjectClasses>

    <!--   ===========   Custom Agent: Client   =========== -->
    <ActiveObjectClass>
      <Id>1730000000010</Id>
      <Name><![CDATA[Client]]></Name>
      <FlowChartsUsage>ENTITY</FlowChartsUsage>
      <Parameters>
        <Parameter>
          <Name><![CDATA[requestType]]></Name>
          <Type><![CDATA[int]]></Type>
          <DefaultValue><![CDATA[0]]></DefaultValue>
          <Description><![CDATA[
            Request type encoding:
              0 = QQ (Quick Question)
              1 = SR (Supply / Item Request)
              2 = RA (Room Access)
              3 = LA (Longer Assistance)
          ]]></Description>
        </Parameter>
        <Parameter>
          <Name><![CDATA[serviceTime]]></Name>
          <Type><![CDATA[double]]></Type>
          <DefaultValue><![CDATA[0.0]]></DefaultValue>
          <Description><![CDATA[
            Sampled service time in minutes; set on the SelectOutput
            branch corresponding to the request type.
          ]]></Description>
        </Parameter>
      </Parameters>
    </ActiveObjectClass>

    <!--   ===========   Main: Base Model   =========== -->
    <ActiveObjectClass>
      <Id>1730000000020</Id>
      <Name><![CDATA[MainBase]]></Name>
      <FlowChartsUsage>STANDARD</FlowChartsUsage>
      <Description><![CDATA[
        Base model - one shared FIFO queue, two homogeneous servers.
        Both servers can handle all 4 request types; service-time
        distribution is determined by request type, not by server.
      ]]></Description>

      <ProcessFlow>

        <Block class="Source">
          <Name><![CDATA[arrivals]]></Name>
          <AgentType><![CDATA[Client]]></AgentType>
          <Property name="arrivalDefinedBy">RATE</Property>
          <Property name="rate"><![CDATA[exponential(1.0/3.9)]]></Property>
          <Property name="rateUnits"><![CDATA[PER_MINUTE]]></Property>
          <Comment><![CDATA[
            Inter-arrival time = Exponential(mean = 3.9 min).
            Equivalent: rate = 1/3.9 per minute.
          ]]></Comment>
        </Block>

        <Block class="SelectOutput5">
          <Name><![CDATA[selectRequestType]]></Name>
          <Property name="useConditions">false</Property>
          <Property name="probability1">0.37</Property>
          <Property name="probability2">0.27</Property>
          <Property name="probability3">0.20</Property>
          <Property name="probability4">0.16</Property>
          <Property name="probability5">0.0</Property>
          <OnExit1><![CDATA[
            agent.requestType = 0;
            agent.serviceTime = triangular(1, 3, 5);
          ]]></OnExit1>
          <OnExit2><![CDATA[
            agent.requestType = 1;
            agent.serviceTime = triangular(4, 6, 9);
          ]]></OnExit2>
          <OnExit3><![CDATA[
            agent.requestType = 2;
            agent.serviceTime = triangular(8, 12, 15);
          ]]></OnExit3>
          <OnExit4><![CDATA[
            agent.requestType = 3;
            agent.serviceTime = triangular(10, 14, 20);
          ]]></OnExit4>
          <Comment><![CDATA[
            5-output SelectOutput used as 4-way (5th branch unused, p=0).
            Each branch sets agent.requestType and agent.serviceTime.
          ]]></Comment>
        </Block>

        <Block class="Queue">
          <Name><![CDATA[waitingLine]]></Name>
          <Property name="capacity">20</Property>
          <Property name="queuingPolicy">FIFO</Property>
          <Property name="enableExitOnTimeout">false</Property>
          <Property name="enablePreemption">false</Property>
        </Block>

        <Block class="Service">
          <Name><![CDATA[serviceDesk]]></Name>
          <Property name="seizeResource">UNITS</Property>
          <Property name="resourcePool"><![CDATA[staff]]></Property>
          <Property name="capacity">2</Property>
          <Property name="delayTime"><![CDATA[agent.serviceTime]]></Property>
          <Property name="delayTimeUnits"><![CDATA[MINUTE]]></Property>
        </Block>

        <Block class="Sink">
          <Name><![CDATA[exit]]></Name>
        </Block>

        <ResourcePool>
          <Name><![CDATA[staff]]></Name>
          <Capacity>2</Capacity>
          <UnitName><![CDATA[StaffMember]]></UnitName>
        </ResourcePool>

        <Connections>
          <Connection from="arrivals.out"  to="selectRequestType.in"/>
          <Connection from="selectRequestType.out1" to="waitingLine.in"/>
          <Connection from="selectRequestType.out2" to="waitingLine.in"/>
          <Connection from="selectRequestType.out3" to="waitingLine.in"/>
          <Connection from="selectRequestType.out4" to="waitingLine.in"/>
          <Connection from="waitingLine.out" to="serviceDesk.in"/>
          <Connection from="serviceDesk.out" to="exit.in"/>
        </Connections>

      </ProcessFlow>

      <Statistics>
        <TimeMeasureStart name="waitStart" before="waitingLine.in"/>
        <TimeMeasureEnd   name="waitEnd"   after="waitingLine.out"/>
        <Histogram name="waitTimeHist" source="waitEnd"/>
        <DataSet name="queueLengthOverTime" source="waitingLine.size()"/>
        <Variable name="totalServed" type="int" initial="0"
                  onSink="totalServed++"/>
        <Variable name="serverAUtil" expression="serviceDesk.utilization()"/>
      </Statistics>
    </ActiveObjectClass>

    <!--   ===========   Main: Improvement 1 (Dedicated Lanes)  =========== -->
    <ActiveObjectClass>
      <Id>1730000000030</Id>
      <Name><![CDATA[MainImprovement1]]></Name>
      <FlowChartsUsage>STANDARD</FlowChartsUsage>
      <Description><![CDATA[
        Improvement 1 - QQ/SR routed to Server A; RA/LA routed to
        Server B.  Each server has its own FIFO queue.  Implements
        the SelectOutput-based routing the professor asked about.
      ]]></Description>

      <ProcessFlow>

        <Block class="Source">
          <Name><![CDATA[arrivals]]></Name>
          <AgentType><![CDATA[Client]]></AgentType>
          <Property name="rate"><![CDATA[exponential(1.0/3.9)]]></Property>
          <Property name="rateUnits"><![CDATA[PER_MINUTE]]></Property>
        </Block>

        <Block class="SelectOutput5">
          <Name><![CDATA[selectRequestType]]></Name>
          <Property name="probability1">0.37</Property>
          <Property name="probability2">0.27</Property>
          <Property name="probability3">0.20</Property>
          <Property name="probability4">0.16</Property>
          <Property name="probability5">0.0</Property>
          <OnExit1><![CDATA[
            agent.requestType = 0;
            agent.serviceTime = triangular(1, 3, 5);
          ]]></OnExit1>
          <OnExit2><![CDATA[
            agent.requestType = 1;
            agent.serviceTime = triangular(4, 6, 9);
          ]]></OnExit2>
          <OnExit3><![CDATA[
            agent.requestType = 2;
            agent.serviceTime = triangular(8, 12, 15);
          ]]></OnExit3>
          <OnExit4><![CDATA[
            agent.requestType = 3;
            agent.serviceTime = triangular(10, 14, 20);
          ]]></OnExit4>
        </Block>

        <Block class="SelectOutput">
          <Name><![CDATA[routeByType]]></Name>
          <Property name="condition"><![CDATA[
            agent.requestType <= 1
          ]]></Property>
          <Comment><![CDATA[
            true  -> QQ or SR -> Server A lane
            false -> RA or LA -> Server B lane
          ]]></Comment>
        </Block>

        <Block class="Queue">
          <Name><![CDATA[queueA]]></Name>
          <Property name="capacity">20</Property>
          <Property name="queuingPolicy">FIFO</Property>
        </Block>
        <Block class="Queue">
          <Name><![CDATA[queueB]]></Name>
          <Property name="capacity">20</Property>
          <Property name="queuingPolicy">FIFO</Property>
        </Block>

        <Block class="Service">
          <Name><![CDATA[serverA]]></Name>
          <Property name="resourcePool"><![CDATA[staffA]]></Property>
          <Property name="capacity">1</Property>
          <Property name="delayTime"><![CDATA[agent.serviceTime]]></Property>
          <Property name="delayTimeUnits"><![CDATA[MINUTE]]></Property>
        </Block>
        <Block class="Service">
          <Name><![CDATA[serverB]]></Name>
          <Property name="resourcePool"><![CDATA[staffB]]></Property>
          <Property name="capacity">1</Property>
          <Property name="delayTime"><![CDATA[agent.serviceTime]]></Property>
          <Property name="delayTimeUnits"><![CDATA[MINUTE]]></Property>
        </Block>

        <Block class="Sink">
          <Name><![CDATA[exit]]></Name>
        </Block>

        <ResourcePool>
          <Name><![CDATA[staffA]]></Name>
          <Capacity>1</Capacity>
        </ResourcePool>
        <ResourcePool>
          <Name><![CDATA[staffB]]></Name>
          <Capacity>1</Capacity>
        </ResourcePool>

        <Connections>
          <Connection from="arrivals.out"          to="selectRequestType.in"/>
          <Connection from="selectRequestType.out1" to="routeByType.in"/>
          <Connection from="selectRequestType.out2" to="routeByType.in"/>
          <Connection from="selectRequestType.out3" to="routeByType.in"/>
          <Connection from="selectRequestType.out4" to="routeByType.in"/>
          <Connection from="routeByType.outT" to="queueA.in"/>
          <Connection from="routeByType.outF" to="queueB.in"/>
          <Connection from="queueA.out"       to="serverA.in"/>
          <Connection from="queueB.out"       to="serverB.in"/>
          <Connection from="serverA.out"      to="exit.in"/>
          <Connection from="serverB.out"      to="exit.in"/>
        </Connections>

      </ProcessFlow>
    </ActiveObjectClass>

    <!--   ===========   Main: Improvement 2 (3rd Staff at Peak)  =========== -->
    <ActiveObjectClass>
      <Id>1730000000040</Id>
      <Name><![CDATA[MainImprovement2]]></Name>
      <FlowChartsUsage>STANDARD</FlowChartsUsage>
      <Description><![CDATA[
        Improvement 2 - same flow as Base but with 3 servers active for
        the entire 2-hour observation window.  Models the effect of
        recruiting one extra peak-time volunteer.  Uses identical
        distributions to the base model so results are directly
        comparable.
      ]]></Description>

      <ProcessFlow>

        <Block class="Source">
          <Name><![CDATA[arrivals]]></Name>
          <AgentType><![CDATA[Client]]></AgentType>
          <Property name="rate"><![CDATA[exponential(1.0/3.9)]]></Property>
          <Property name="rateUnits"><![CDATA[PER_MINUTE]]></Property>
        </Block>

        <Block class="SelectOutput5">
          <Name><![CDATA[selectRequestType]]></Name>
          <Property name="probability1">0.37</Property>
          <Property name="probability2">0.27</Property>
          <Property name="probability3">0.20</Property>
          <Property name="probability4">0.16</Property>
          <Property name="probability5">0.0</Property>
          <OnExit1><![CDATA[
            agent.requestType = 0;
            agent.serviceTime = triangular(1, 3, 5);
          ]]></OnExit1>
          <OnExit2><![CDATA[
            agent.requestType = 1;
            agent.serviceTime = triangular(4, 6, 9);
          ]]></OnExit2>
          <OnExit3><![CDATA[
            agent.requestType = 2;
            agent.serviceTime = triangular(8, 12, 15);
          ]]></OnExit3>
          <OnExit4><![CDATA[
            agent.requestType = 3;
            agent.serviceTime = triangular(10, 14, 20);
          ]]></OnExit4>
        </Block>

        <Block class="Queue">
          <Name><![CDATA[waitingLine]]></Name>
          <Property name="capacity">20</Property>
          <Property name="queuingPolicy">FIFO</Property>
        </Block>

        <Block class="Service">
          <Name><![CDATA[serviceDesk]]></Name>
          <Property name="resourcePool"><![CDATA[staff]]></Property>
          <Property name="capacity">3</Property>
          <Property name="delayTime"><![CDATA[agent.serviceTime]]></Property>
          <Property name="delayTimeUnits"><![CDATA[MINUTE]]></Property>
        </Block>

        <Block class="Sink">
          <Name><![CDATA[exit]]></Name>
        </Block>

        <ResourcePool>
          <Name><![CDATA[staff]]></Name>
          <Capacity>3</Capacity>
        </ResourcePool>

        <Connections>
          <Connection from="arrivals.out"          to="selectRequestType.in"/>
          <Connection from="selectRequestType.out1" to="waitingLine.in"/>
          <Connection from="selectRequestType.out2" to="waitingLine.in"/>
          <Connection from="selectRequestType.out3" to="waitingLine.in"/>
          <Connection from="selectRequestType.out4" to="waitingLine.in"/>
          <Connection from="waitingLine.out"        to="serviceDesk.in"/>
          <Connection from="serviceDesk.out"        to="exit.in"/>
        </Connections>

      </ProcessFlow>
    </ActiveObjectClass>

  </ActiveObjectClasses>

  <!-- =================================================================
       SIMULATION EXPERIMENTS
       ================================================================= -->
  <Experiments>

    <Experiment class="SimulationExperiment">
      <Name><![CDATA[BaseSimulation]]></Name>
      <TopLevelClass><![CDATA[MainBase]]></TopLevelClass>
      <StopType>STOP_AT</StopType>
      <StopTime>120</StopTime>
      <TimeUnit>MINUTE</TimeUnit>
      <ExecutionMode>VIRTUAL_TIME</ExecutionMode>
      <RandomSeed>1</RandomSeed>
    </Experiment>

    <Experiment class="ParametricExperiment">
      <Name><![CDATA[BaseReplications]]></Name>
      <TopLevelClass><![CDATA[MainBase]]></TopLevelClass>
      <StopTime>120</StopTime>
      <TimeUnit>MINUTE</TimeUnit>
      <Replications>30</Replications>
      <RandomSeedMode>UNIQUE</RandomSeedMode>
      <Description><![CDATA[
        30 replications of the Base model.  Aggregate avg wait, avg
        queue length, server utilization, and clients served across
        all replications.
      ]]></Description>
    </Experiment>

    <Experiment class="ParametricExperiment">
      <Name><![CDATA[Improvement1Replications]]></Name>
      <TopLevelClass><![CDATA[MainImprovement1]]></TopLevelClass>
      <StopTime>120</StopTime>
      <TimeUnit>MINUTE</TimeUnit>
      <Replications>30</Replications>
      <RandomSeedMode>UNIQUE</RandomSeedMode>
    </Experiment>

    <Experiment class="ParametricExperiment">
      <Name><![CDATA[Improvement2Replications]]></Name>
      <TopLevelClass><![CDATA[MainImprovement2]]></TopLevelClass>
      <StopTime>120</StopTime>
      <TimeUnit>MINUTE</TimeUnit>
      <Replications>30</Replications>
      <RandomSeedMode>UNIQUE</RandomSeedMode>
    </Experiment>

  </Experiments>
</Model>
</AnyLogicWorkspace>
