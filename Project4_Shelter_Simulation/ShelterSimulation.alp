<?xml version="1.0" encoding="UTF-8"?>
<!--
*****************************************************************
                AnyLogic Project File - Hand-crafted Blueprint
*****************************************************************
  Project: Stephen Center Front Office Simulation (Project 4)
  Author:  Carlos Jordan
  Course:  University of Nebraska Omaha, Spring 2026

  IMPORTANT - read me first
  =========================
  AnyLogic .alp files are normally generated by the AnyLogic IDE and
  contain hundreds of internal numeric IDs, screen coordinates, and
  schema-specific metadata that cannot be reliably reproduced by hand.
  This file is therefore a HAND-CRAFTED BLUEPRINT in the AnyLogic XML
  style: it documents every block, parameter, distribution, and
  connector in the model in the same XML format an .alp file uses, so
  it can be diffed in version control and read by AnyLogic for
  reference.

  DO NOT expect this file to open as a fully editable model in
  AnyLogic. The canonical way to recreate the model is to follow the
  step-by-step instructions in AnyLogic_Build_Guide.md, which produce
  the exact same blocks and parameters listed below.
-->
<AnyLogicWorkspace WorkspaceVersion="1.9"
                   AnyLogicVersion="8.9.0"
                   AlpVersion="8.9">
  <Model>
    <Id>1714000000001</Id>
    <Name><![CDATA[ShelterSimulation]]></Name>
    <EngineVersion>6</EngineVersion>
    <JavaPackageName><![CDATA[sheltersimulation]]></JavaPackageName>
    <ModelTimeUnit><![CDATA[Minute]]></ModelTimeUnit>

    <!--
      ============================================================
      Agent type: Client
      ============================================================
      Each homeless client passing through the front office is
      represented as a Client agent. The agent carries two parameters:
        - requestType   (int)     0=QQ, 1=SR, 2=RA, 3=LA
        - serviceTime   (double)  drawn from a triangular distribution
                                   when the client passes the
                                   SelectOutput block (see below)
      ============================================================
    -->
    <ActiveObjectClasses>

      <ActiveObjectClass>
        <Id>1714000000010</Id>
        <Name><![CDATA[Client]]></Name>
        <Generic>false</Generic>
        <FlowChartsUsage>ENTITY</FlowChartsUsage>

        <Parameters>
          <Parameter>
            <Id>1714000000011</Id>
            <Name><![CDATA[requestType]]></Name>
            <Type><![CDATA[int]]></Type>
            <DefaultValue><![CDATA[0]]></DefaultValue>
            <Description><![CDATA[
              0 = Quick Question (QQ)
              1 = Supply / Item Request (SR)
              2 = Room Access (RA)
              3 = Longer Assistance (LA)
            ]]></Description>
          </Parameter>
          <Parameter>
            <Id>1714000000012</Id>
            <Name><![CDATA[serviceTime]]></Name>
            <Type><![CDATA[double]]></Type>
            <DefaultValue><![CDATA[0.0]]></DefaultValue>
            <Description><![CDATA[
              Service-desk time in minutes for this client. Drawn from
              the triangular distribution that matches the client's
              requestType when the agent passes the SelectOutput block.
            ]]></Description>
          </Parameter>
        </Parameters>
      </ActiveObjectClass>

      <!--
        ============================================================
        Active Object Class: Main (the process flowchart)
        ============================================================
        The Main agent contains the discrete-event flowchart for the
        BASE model. The two improvement scenarios are kept in separate
        flowcharts on the same Main canvas (or in cloned models with
        different starting flowcharts), see ShelterSimulation_Imp1
        and ShelterSimulation_Imp2 below.
        ============================================================
      -->
      <ActiveObjectClass>
        <Id>1714000000100</Id>
        <Name><![CDATA[Main]]></Name>
        <Generic>false</Generic>
        <FlowChartsUsage>USAGE_BLOCKS</FlowChartsUsage>

        <!-- ============================================================
             BASE MODEL flowchart
             Source -> SelectOutput -> Queue -> Service -> Sink
             ============================================================ -->
        <FlowChart Name="BaseModel">

          <Source>
            <Id>1714000000200</Id>
            <Name><![CDATA[clientArrivals]]></Name>
            <Description><![CDATA[Walk-in clients arriving at the front
              office between 6:00 PM and 8:00 PM]]></Description>
            <ArrivalDefinedBy><![CDATA[INTERARRIVAL_TIME]]></ArrivalDefinedBy>
            <InterarrivalTime>
              <Code><![CDATA[exponential(1.0 / 3.9)]]></Code>
              <Unit><![CDATA[MINUTE]]></Unit>
            </InterarrivalTime>
            <NewAgent>
              <AgentType><![CDATA[Client]]></AgentType>
            </NewAgent>
            <SetAgentParametersFromDB>false</SetAgentParametersFromDB>
            <LimitNumberOfArrivals>false</LimitNumberOfArrivals>
            <Position><X>40</X><Y>120</Y></Position>
          </Source>

          <SelectOutput5>
            <Id>1714000000210</Id>
            <Name><![CDATA[selectRequestType]]></Name>
            <Description><![CDATA[Routes each client to one of four
              parallel branches by request type, using the empirical
              type probabilities. Each branch tags the client with its
              requestType id and draws a triangular service time.]]></Description>
            <ConditionType><![CDATA[PROBABILITIES]]></ConditionType>
            <Probability1><![CDATA[0.37]]></Probability1>
            <Probability2><![CDATA[0.27]]></Probability2>
            <Probability3><![CDATA[0.20]]></Probability3>
            <Probability4><![CDATA[0.16]]></Probability4>
            <!--
              Note: probabilities total 1.00 (0.37 + 0.27 + 0.20 + 0.16).
              The 5th output is unused and has probability 0.00.
            -->
            <Probability5><![CDATA[0.00]]></Probability5>

            <OnExit1><![CDATA[
              // QQ - Quick Question
              agent.requestType = 0;
              agent.serviceTime = triangular(1, 3, 5);
            ]]></OnExit1>
            <OnExit2><![CDATA[
              // SR - Supply / Item Request
              agent.requestType = 1;
              agent.serviceTime = triangular(4, 6, 9);
            ]]></OnExit2>
            <OnExit3><![CDATA[
              // RA - Room Access
              agent.requestType = 2;
              agent.serviceTime = triangular(8, 12, 15);
            ]]></OnExit3>
            <OnExit4><![CDATA[
              // LA - Longer Assistance
              agent.requestType = 3;
              agent.serviceTime = triangular(10, 14, 20);
            ]]></OnExit4>

            <Position><X>200</X><Y>120</Y></Position>
          </SelectOutput5>

          <TimeMeasureStart>
            <Id>1714000000220</Id>
            <Name><![CDATA[startWaitTimer]]></Name>
            <Description><![CDATA[Start of wait-time measurement. Runs
              until the client enters the Service block.]]></Description>
            <Position><X>360</X><Y>120</Y></Position>
          </TimeMeasureStart>

          <Queue>
            <Id>1714000000230</Id>
            <Name><![CDATA[waitingLine]]></Name>
            <Description><![CDATA[Single shared FIFO queue. Capacity is
              set comfortably above the maximum observed queue length so
              the queue never blocks the source.]]></Description>
            <Capacity><![CDATA[20]]></Capacity>
            <QueueType><![CDATA[FIFO]]></QueueType>
            <PreemptionPolicy><![CDATA[NONE]]></PreemptionPolicy>
            <RestoreAgentLocationOnExit>false</RestoreAgentLocationOnExit>
            <Position><X>440</X><Y>120</Y></Position>
          </Queue>

          <TimeMeasureEnd>
            <Id>1714000000235</Id>
            <Name><![CDATA[endWaitTimer]]></Name>
            <Description><![CDATA[Stops the wait-time measurement. The
              elapsed time between startWaitTimer and endWaitTimer is
              the per-client wait. Output is collected into a histogram.
            ]]></Description>
            <TimeMeasureStartRef><![CDATA[startWaitTimer]]></TimeMeasureStartRef>
            <Position><X>520</X><Y>120</Y></Position>
          </TimeMeasureEnd>

          <Service>
            <Id>1714000000240</Id>
            <Name><![CDATA[serviceDesk]]></Name>
            <Description><![CDATA[Service block representing the staff at
              the front office. Two interchangeable servers; service
              time is read from agent.serviceTime which was set at the
              SelectOutput block.]]></Description>
            <ResourcePool><![CDATA[staff]]></ResourcePool>
            <NumberOfResourceUnits><![CDATA[1]]></NumberOfResourceUnits>
            <NumberOfServers><![CDATA[2]]></NumberOfServers>
            <DelayTime>
              <Code><![CDATA[agent.serviceTime]]></Code>
              <Unit><![CDATA[MINUTE]]></Unit>
            </DelayTime>
            <QueueCapacity><![CDATA[0]]></QueueCapacity>
            <Position><X>620</X><Y>120</Y></Position>
          </Service>

          <Sink>
            <Id>1714000000250</Id>
            <Name><![CDATA[clientExits]]></Name>
            <Description><![CDATA[Client leaves the front office.
              Increments totalServed counter via on-enter action.]]></Description>
            <OnEnter><![CDATA[
              totalServed++;
            ]]></OnEnter>
            <Position><X>760</X><Y>120</Y></Position>
          </Sink>

          <!-- Connectors (data flow) -->
          <Connector><From>clientArrivals.out</From><To>selectRequestType.in</To></Connector>
          <Connector><From>selectRequestType.out1</From><To>startWaitTimer.in</To></Connector>
          <Connector><From>selectRequestType.out2</From><To>startWaitTimer.in</To></Connector>
          <Connector><From>selectRequestType.out3</From><To>startWaitTimer.in</To></Connector>
          <Connector><From>selectRequestType.out4</From><To>startWaitTimer.in</To></Connector>
          <Connector><From>startWaitTimer.out</From><To>waitingLine.in</To></Connector>
          <Connector><From>waitingLine.out</From><To>endWaitTimer.in</To></Connector>
          <Connector><From>endWaitTimer.out</From><To>serviceDesk.in</To></Connector>
          <Connector><From>serviceDesk.out</From><To>clientExits.in</To></Connector>

        </FlowChart>

        <!-- ============================================================
             Statistics and KPIs
             ============================================================ -->
        <Variables>
          <Variable>
            <Name><![CDATA[totalServed]]></Name>
            <Type><![CDATA[int]]></Type>
            <Initial><![CDATA[0]]></Initial>
          </Variable>
        </Variables>

        <HistogramData>
          <Name><![CDATA[waitTimes]]></Name>
          <NumberOfIntervals>15</NumberOfIntervals>
          <AutomaticRange>true</AutomaticRange>
        </HistogramData>
        <HistogramData>
          <Name><![CDATA[serviceTimes]]></Name>
          <NumberOfIntervals>20</NumberOfIntervals>
          <AutomaticRange>true</AutomaticRange>
        </HistogramData>

        <!-- Charts (referenced by the build guide) -->
        <Chart>
          <Name><![CDATA[chartWaitTimeHistogram]]></Name>
          <DataItem><![CDATA[endWaitTimer.distribution]]></DataItem>
        </Chart>
        <Chart>
          <Name><![CDATA[chartQueueLengthOverTime]]></Name>
          <DataItem><![CDATA[waitingLine.size()]]></DataItem>
          <SamplingPeriod><![CDATA[1.0]]></SamplingPeriod>
        </Chart>

      </ActiveObjectClass>

      <!--
        ============================================================
        Improvement scenario 1: dedicated quick-service lane
        ============================================================
        Two parallel lanes after a SelectOutput. QQ + SR (quick) go
        to lane A; RA + LA (long) go to lane B. Each lane has its
        own queue and its own dedicated server.
        ============================================================
      -->
      <ActiveObjectClass>
        <Id>1714000000300</Id>
        <Name><![CDATA[ShelterSimulation_Imp1]]></Name>
        <FlowChart Name="DedicatedLanes">
          <SelectOutput>
            <Name><![CDATA[laneRouter]]></Name>
            <ConditionType><![CDATA[CONDITION]]></ConditionType>
            <Condition><![CDATA[
              // True branch: short-service lane (QQ + SR)
              return agent.requestType == 0 || agent.requestType == 1;
            ]]></Condition>
          </SelectOutput>

          <Queue><Name><![CDATA[queueQuick]]></Name><Capacity>20</Capacity></Queue>
          <Service><Name><![CDATA[serviceQuick]]></Name>
            <NumberOfServers>1</NumberOfServers>
            <DelayTime><Code><![CDATA[agent.serviceTime]]></Code></DelayTime>
          </Service>

          <Queue><Name><![CDATA[queueLong]]></Name><Capacity>20</Capacity></Queue>
          <Service><Name><![CDATA[serviceLong]]></Name>
            <NumberOfServers>1</NumberOfServers>
            <DelayTime><Code><![CDATA[agent.serviceTime]]></Code></DelayTime>
          </Service>

          <Sink><Name><![CDATA[clientExitsImp1]]></Name></Sink>

          <Connector><From>clientArrivals.out</From><To>selectRequestType.in</To></Connector>
          <Connector><From>selectRequestType.out_all</From><To>laneRouter.in</To></Connector>
          <Connector><From>laneRouter.outT</From><To>queueQuick.in</To></Connector>
          <Connector><From>laneRouter.outF</From><To>queueLong.in</To></Connector>
          <Connector><From>queueQuick.out</From><To>serviceQuick.in</To></Connector>
          <Connector><From>queueLong.out</From><To>serviceLong.in</To></Connector>
          <Connector><From>serviceQuick.out</From><To>clientExitsImp1.in</To></Connector>
          <Connector><From>serviceLong.out</From><To>clientExitsImp1.in</To></Connector>
        </FlowChart>
      </ActiveObjectClass>

      <!--
        ============================================================
        Improvement scenario 2: third staff member during peak
        ============================================================
        Same shared-queue layout as the base model, but the Service
        block is wired to a ResourcePool of size 3. The "only during
        the first hour" aspect is modelled with a Schedule resource
        that toggles the third server's availability between time 0
        and time 60.
        ============================================================
      -->
      <ActiveObjectClass>
        <Id>1714000000400</Id>
        <Name><![CDATA[ShelterSimulation_Imp2]]></Name>
        <FlowChart Name="ThirdStaffAtPeak">
          <Service><Name><![CDATA[serviceDeskImp2]]></Name>
            <NumberOfServers>
              <Code><![CDATA[time() < 60 ? 3 : 2]]></Code>
            </NumberOfServers>
            <DelayTime><Code><![CDATA[agent.serviceTime]]></Code></DelayTime>
          </Service>
          <Comment><![CDATA[
            All other blocks (Source, SelectOutput, Queue, Sink) are
            identical to the base model. Only the Service block changes.
          ]]></Comment>
        </FlowChart>
      </ActiveObjectClass>

    </ActiveObjectClasses>

    <!-- ============================================================
         Simulation experiment
         ============================================================ -->
    <Experiments>
      <SimulationExperiment>
        <Id>1714000000500</Id>
        <Name><![CDATA[Simulation]]></Name>
        <ActiveObjectClass>Main</ActiveObjectClass>
        <StopType><![CDATA[STOP_AT]]></StopType>
        <StopTime><![CDATA[120]]></StopTime>
        <ModelTimeUnit><![CDATA[Minute]]></ModelTimeUnit>
        <ExecutionMode><![CDATA[VIRTUAL_TIME]]></ExecutionMode>
        <RealTimeScale>1</RealTimeScale>
        <RandomSeedType><![CDATA[FIXED]]></RandomSeedType>
        <RandomSeed>1</RandomSeed>
      </SimulationExperiment>

      <MonteCarloExperiment>
        <Id>1714000000510</Id>
        <Name><![CDATA[Replications]]></Name>
        <ActiveObjectClass>Main</ActiveObjectClass>
        <NumberOfReplications>30</NumberOfReplications>
        <StopTime><![CDATA[120]]></StopTime>
        <CollectStatistics>true</CollectStatistics>
        <CollectedKpis>
          <Kpi>endWaitTimer.distribution.mean()</Kpi>
          <Kpi>endWaitTimer.distribution.max()</Kpi>
          <Kpi>statistics(waitingLine.size()).mean()</Kpi>
          <Kpi>serviceDesk.utilization()</Kpi>
          <Kpi>totalServed</Kpi>
        </CollectedKpis>
      </MonteCarloExperiment>
    </Experiments>
  </Model>
</AnyLogicWorkspace>
